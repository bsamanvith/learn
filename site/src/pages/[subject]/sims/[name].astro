---
import { Code } from "astro:components";
import Base from "../../../layouts/Base.astro";
import { meta } from "../../../subjects";

export async function getStaticPaths() {
  const files = import.meta.glob("../../../../../subjects/*/sims/*.py", { query: "?raw", import: "default", eager: true });
  return Object.entries(files).map(([p, code]) => {
    const parts = p.split("/");
    return {
      params: { subject: parts.at(-3)!, name: parts.at(-1)!.replace(/\.py$/, "") },
      props: { code: code as string },
    };
  });
}
const { subject, name } = Astro.params;
const { code } = Astro.props;
const title = meta(subject)?.title ?? subject;
---
<Base title={`${name}.py · ${title}`} subject={{ slug: subject, title }}>
  <main class="sim-page prose" style="max-width:900px">
    <p class="kicker"><a href={`/${subject}/`}>{title} · simulation</a></p>
    <h1 style="font-family:var(--mono);font-size:1.8rem;letter-spacing:0">{name}.py</h1>
    <p>Run it from the repo root (after the setup in <code>tools/README.md</code>):</p>
    <pre><code>.venv/bin/python subjects/{subject}/sims/{name}.py</code></pre>
    <Code code={code} lang="python" themes={{ light: "github-light", dark: "github-dark" }} defaultColor={false} />
  </main>
</Base>
