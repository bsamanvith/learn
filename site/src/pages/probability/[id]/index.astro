---
import { getCollection, render } from "astro:content";
import Chapter from "../../../layouts/Chapter.astro";
import { PARTS, byChapter } from "../../../book";

export async function getStaticPaths() {
  const chapters = (await getCollection("text")).sort(byChapter);
  return chapters.map((entry, i) => ({ params: { id: entry.id }, props: { entry, prev: chapters[i - 1], next: chapters[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const all = await getCollection("text");
const exercises = await getCollection("exercises");
const hasExercises = exercises.some((e) => e.id === entry.id);
const link = (ch: string) => {
  const c = all.find((x) => x.data.chapter === ch);
  return c ? { href: `/probability/${c.id}/`, label: `${ch} ${c.data.title}` } : { href: undefined, label: ch };
};
---
<Chapter title={`${entry.data.chapter} ${entry.data.title} · Probability`} id={entry.id} headings={headings}>
  <p class="kicker"><a href="/">Part {entry.data.part} · {PARTS[entry.data.part]?.title}</a></p>
  <nav class="tabs" aria-label="Chapter views">
    <a href={`/probability/${entry.id}/`} aria-current="page">Read</a>
    {hasExercises && <a href={`/probability/${entry.id}/exercises/`}>Exercises</a>}
  </nav>
  <div class="chapter-meta">
    {entry.data.prerequisites.length > 0 && <span>Builds on</span>}
    {entry.data.prerequisites.map((p) => { const l = link(p); return l.href ? <a class="chip" href={l.href}>← {l.label}</a> : <span class="chip">← {p}</span>; })}
    {entry.data.status === "draft" && <span class="chip status">draft</span>}
  </div>
  <Content />
  {entry.data.leads_to.length > 0 && (
    <div class="chapter-meta" style="margin-top:2.5em">
      <span>Leads to</span>
      {entry.data.leads_to.map((p) => { const l = link(p); return l.href ? <a class="chip" href={l.href}>{l.label} →</a> : <span class="chip" title="Not written yet">{p} →</span>; })}
    </div>
  )}
  <nav class="pager">
    {hasExercises
      ? <a class="next" href={`/probability/${entry.id}/exercises/`}><small>Practice</small>Exercises {entry.data.chapter} →</a>
      : next && <a class="next" href={`/probability/${next.id}/`}><small>Next</small>{next.data.chapter} {next.data.title} →</a>}
    {prev && <a href={`/probability/${prev.id}/`} style="grid-row:1;grid-column:1"><small>Previous</small>← {prev.data.chapter} {prev.data.title}</a>}
  </nav>
</Chapter>
